---
import { Play } from '@lucide/astro';
import { VIDEO } from '../../data/video';

// Con video se reproduce; con solo la portada se ve el mismo efecto sobre una
// imagen quieta. Sin ninguno de los dos, la sección no existe: un recuadro
// vacío esperando material se lee como una página a medio terminar.
const hayVideo = VIDEO.archivo !== null;
const hayAlgo = hayVideo || VIDEO.portada !== null;
---

{
  hayAlgo && (
    <section class="video" id="video">
      {/* El alto de esta sección ES el recorrido del efecto: mientras dura,
          la caja de adentro queda pegada y el video crece. Tres pantallas dan
          un crecimiento que se siente, sin obligar a scrollear de más. */}
      <div class="video__pista" id="video-pista">
        <div class="video__visor">
          <p class="video__rotulo" aria-hidden="true">
            <Play class="video__play" size={13} stroke-width={2.5} fill="currentColor" />
            {VIDEO.rotulo}
          </p>

          {/* `playsinline` es obligatorio: sin él, iPhone abre el video a
              pantalla completa en cuanto arranca y se rompe el efecto.
              `muted` también: ningún navegador deja reproducir solo con
              sonido, y sin esta bandera el video simplemente no arranca. */}
          {
            hayVideo ? (
              <video
                class="video__pieza"
                id="video-pieza"
                src={VIDEO.archivo!}
                poster={VIDEO.portada ?? undefined}
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={VIDEO.descripcion}
              />
            ) : (
              <img class="video__pieza" src={VIDEO.portada!} alt={VIDEO.descripcion} loading="lazy" />
            )
          }
        </div>
      </div>
    </section>
  )
}

{
  hayAlgo && (
    <script>
      {/* El video crece con el scroll. Dos cuidados:
          · El cálculo va dentro de `requestAnimationFrame`: el evento de scroll
            se dispara decenas de veces por segundo y escribir estilos en cada
            uno fuerza recálculos de layout.
          · Se anima el ANCHO y no `scale`: escalar deformaría el radio de las
            esquinas y el video terminaría con las puntas ovaladas. */}
      const pista = document.getElementById('video-pista');
      const pieza = document.getElementById('video-pieza');

      if (pista) {
        let pendiente = false;

        const pintar = () => {
          pendiente = false;
          const caja = pista.getBoundingClientRect();
          const recorrido = caja.height - window.innerHeight;
          if (recorrido <= 0) return;
          const avance = Math.min(1, Math.max(0, -caja.top / recorrido));
          // Suavizado: arranca despacio y termina despacio, para que el final
          // no se sienta como un frenazo.
          const suave = avance < 0.5 ? 2 * avance * avance : 1 - (-2 * avance + 2) ** 2 / 2;
          pista.style.setProperty('--avance', String(suave));
        };

        const agendar = () => {
          if (pendiente) return;
          pendiente = true;
          requestAnimationFrame(pintar);
        };

        window.addEventListener('scroll', agendar, { passive: true });
        window.addEventListener('resize', agendar);
        pintar();

        // El video solo corre mientras se ve. Un video en bucle fuera de
        // pantalla gasta batería sin que nadie lo mire. Con la portada sola no
        // hay nada que pausar.
        if (pieza instanceof HTMLVideoElement) {
          new IntersectionObserver(
            ([e]) => {
              if (e.isIntersecting) pieza.play().catch(() => {});
              else pieza.pause();
            },
            { threshold: 0.1 },
          ).observe(pieza);
        }
      }
    </script>
  )
}

<style>
  .video__pista {
    /* Medido en la referencia: el recuadro termina de crecer en unos 600 px de
       scroll y ahí SUELTA — se va con la página como cualquier sección. Tres
       pantallas pegadas, que era lo que tenía antes, se sienten eternas: la
       persona sigue bajando y la pantalla no avanza. */
    height: calc(100vh + 620px);
    height: calc(100svh + 620px);
    --avance: 0;
  }

  /* Rótulo y recuadro en UNA columna, no posicionados por separado: así la
     distancia entre ellos es siempre la misma, en cualquier pantalla y en
     cualquier punto del scroll. Posicionados aparte, cada uno se movía con su
     propio porcentaje y el hueco crecía o se cerraba solo. */
  .video__visor {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Medido contra la referencia en 1440x900: 178 px entre el final del hero
       y el rótulo, 28 entre el rótulo y el recuadro, y el recuadro asomando
       unos 50 px por el pie de la primera pantalla. Con menos hueco el bloque
       se apelmaza; con el recuadro asomando de más, deja de ser una invitación
       y se vuelve otra sección. */
    gap: 28px;
    height: 100vh;
    height: 100svh;
    padding-top: 8.5vh;
    overflow: hidden;
  }

  .video__rotulo {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--e-2);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--tinta);
    /* Se va cuando el video ya lo tapó: a partir de la mitad del recorrido
       estorba más de lo que informa. */
    opacity: calc(1 - var(--avance) * 2.5);
    transition: opacity 120ms linear;
  }

  .video__play {
    flex: none;
  }

  .video__pieza {
    display: block;
    flex: none;
    /* De 400 px a 1360, con 40 de margen a cada lado: las medidas exactas de
       la referencia. Se interpola el ANCHO y la altura sale de la proporción,
       así el radio de las esquinas nunca se deforma. */
    width: calc(400px + (min(100vw - 80px, 1360px) - 400px) * var(--avance));
    aspect-ratio: 16 / 9;
    max-width: 96vw;
    object-fit: cover;
    border-radius: calc(24px + 8px * (1 - var(--avance)));
    background: var(--tinta);
  }

  @media (prefers-reduced-motion: reduce) {
    /* Sin recorrido: el video se muestra grande y quieto desde el principio. */
    .video__pista {
      height: auto;
      --avance: 1;
    }

    .video__visor {
      position: static;
      height: auto;
      padding-block: var(--ritmo-seccion);
    }

    .video__rotulo {
      position: static;
      opacity: 1;
      margin-bottom: var(--e-4);
    }
  }
</style>
