---
import { COPY } from '../../data/copy';
import Tarjeta from '../Tarjeta.astro';
import { TIENDAS, rotuloDeTienda } from '../../data/tiendas';

// El fondo del hero queda a la espera del componente que elija el founder.
// Hasta entonces el hero es tipografía sobre la superficie, sin isla: nada de
// JavaScript y nada que pueda fallar al montar.
---

<section class="hero" id="inicio">
  <div class="hero__centro">
    <h1 class="hero__titular">{COPY.titular}</h1>
    <p class="hero__bajada">{COPY.bajada}</p>

    {/* La tarjeta de tienda en vez de un botón inventado: es el badge que ya
        usa el sitio, con el ícono de Play, el rótulo chico arriba y el nombre
        de la tienda abajo. El día que salga iOS, su tarjeta cambia sola de
        "Muy pronto en" a "Descargala en" — el rótulo sale del estado de la
        tienda, no está escrito a mano. */}
    <div class="hero__tiendas">
      {
        TIENDAS.map((tienda) => (
          <Tarjeta
            icono={tienda.icono}
            rotulo={rotuloDeTienda(tienda)}
            nombre={tienda.nombre}
            href={tienda.url ?? undefined}
          />
        ))
      }
    </div>


    <p class="hero__micro">{COPY.hero.microcopy}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    /* Medido en la referencia: el hero termina justo a tiempo para que el
       recuadro del video ASOME en el borde inferior de la primera pantalla.
       Ese pedacito asomando es lo que invita a bajar. Con el hero ocupando la
       ventana entera, el visitante ve una pantalla cerrada y no sabe que hay
       algo más. */
    min-height: min(81vh, 790px);
    padding-block: clamp(var(--e-7), 9vw, 120px) var(--e-6);
    padding-inline: var(--pad-x);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__centro {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--e-5);
    width: min(100%, 52rem);
    text-align: center;
  }

  /* El rasgo de la referencia: enorme, peso medio y muy apretado. Un 900 a este
     tamaño grita; con el interletrado cerrado se lee como tipografía editorial
     y deja que hable el contenido.
     Va en Geist, no en Nunito: es la misma grotesca de la referencia, y su
     trazo recto aguanta el peso 500 a 84 px. Nunito, más redonda y fina, se
     veía floja al mismo número y había que subirla a 600 para compensar. */
  .hero__titular {
    font-family: var(--fuente-titular);
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  .hero__bajada {
    max-width: 34rem;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.625;
    color: var(--tinta-suave);
    text-wrap: pretty;
  }

  .hero__tiendas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--e-3);
  }

  .hero__micro {
    font-size: 0.8125rem;
    color: var(--tinta-suave);
  }
</style>
