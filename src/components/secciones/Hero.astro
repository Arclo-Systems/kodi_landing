---
import { COPY } from '../../data/copy';
import Tarjeta from '../Tarjeta.astro';
import { TIENDAS, rotuloDeTienda } from '../../data/tiendas';
import { MODULOS } from '../../data/modulos';
import FondoHero from '../islas/FondoHero';

// Lo que flota alrededor del titular. En la referencia son fotos porque es una
// app de fotos; acá va lo que Kodi tiene para mostrar: el arte de los cinco
// exámenes y las pantallas reales de la app.
//
// La galería necesita las medidas originales para no deformar nada, y Astro las
// trae en el import de cada imagen.
// Solo el arte de los cinco exámenes: es cuadrado y se lee a cualquier tamaño.
// Las capturas del teléfono se probaron y NO sirven acá — son altas y angostas,
// y a la escala de la rejilla quedan como astillas de color que no dicen nada.
// Las pantallas de la app se muestran en su sección, en un teléfono, que es
// donde se entienden.
const IMAGENES = MODULOS.map((m) => ({
  url: m.arte.src,
  width: m.arte.width,
  height: m.arte.height,
}));

// El mismo valor que `--superficie` en `global.css`. Va literal porque viaja a
// WebGL, que no lee variables de CSS.
const FONDO = '#fafafa';
---

<section class="hero" id="inicio">
  <FondoHero client:load imagenes={IMAGENES} fondo={FONDO} />

  {/* Un velo entre la rejilla y el texto: sin él, una imagen clara que pasa
      justo detrás del titular se lo come. */}
  <div class="hero__velo" aria-hidden="true"></div>

  <div class="hero__centro">
    <h1 class="hero__titular">{COPY.titular}</h1>
    <p class="hero__bajada">{COPY.bajada}</p>

    {/* La tarjeta de tienda en vez de un botón inventado: es el badge que ya
        usa el sitio, con el ícono de Play, el rótulo chico arriba y el nombre
        de la tienda abajo. El día que salga iOS, su tarjeta cambia sola de
        "Muy pronto en" a "Descargala en" — el rótulo sale del estado de la
        tienda, no está escrito a mano. */}
    <div class="hero__tiendas">
      {
        TIENDAS.map((tienda) => (
          <Tarjeta
            icono={tienda.icono}
            rotulo={rotuloDeTienda(tienda)}
            nombre={tienda.nombre}
            href={tienda.url ?? undefined}
          />
        ))
      }
    </div>


    <p class="hero__micro">{COPY.hero.microcopy}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    /* Alto contenido y no `100vh`: una portada que ocupa exactamente la ventana
       deja el resto de la página fuera del primer vistazo, y en un teléfono
       apaisado no entra ni el botón. */
    min-height: min(88vh, 880px);
    padding-block: clamp(var(--e-8), 12vw, 160px);
    padding-inline: var(--pad-x);
    overflow: hidden;
    isolation: isolate;
  }

  /* El velo no es un color plano: se abre en el centro para que el texto tenga
     fondo limpio y deja ver la rejilla entera en los bordes. */
  .hero__velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      58% 46% at 50% 48%,
      var(--superficie) 0%,
      color-mix(in srgb, var(--superficie) 88%, transparent) 52%,
      transparent 82%
    );
    pointer-events: none;
  }

  .hero__centro {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--e-5);
    width: min(100%, 52rem);
    text-align: center;
    /* La rejilla se arrastra con el cursor; el texto de encima no debe
       robarle el gesto salvo en lo que de verdad se toca. */
    pointer-events: none;
  }

  .hero__centro :global(a) {
    pointer-events: auto;
  }

  /* El rasgo de la referencia: enorme, peso MEDIO y muy apretado. Un 900 a este
     tamaño grita; un 500 con el interletrado cerrado se lee como tipografía
     editorial y deja que hable el contenido. */
  .hero__titular {
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  .hero__bajada {
    max-width: 34rem;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.625;
    color: var(--tinta-suave);
    text-wrap: pretty;
  }

  .hero__tiendas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--e-3);
  }

  .hero__micro {
    font-size: 0.8125rem;
    color: var(--tinta-suave);
  }
</style>
