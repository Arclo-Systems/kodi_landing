---
import type { LegalDocument } from '../data/legal';
import { legalDocumentUrl, type LegalDocSlug } from '../data/api';

interface Props {
  /** Cuál documento es — identifica el recurso en el API público. */
  doc: LegalDocSlug;
  documento: LegalDocument;
}

const { doc, documento } = Astro.props;

// El texto horneado se sirve SIEMPRE: la página no depende del API para ser
// legible (es lo que ven los crawlers y quien tenga JS apagado). El fetch de
// abajo solo lo reemplaza si el panel publicó una versión más nueva.
const endpoint = legalDocumentUrl(doc);
---

<article
  class="documento"
  data-legal
  data-legal-endpoint={endpoint}
  data-legal-version={documento.version}
>
  <h1 class="documento__titulo">{documento.title}</h1>
  <p class="documento__fecha" data-legal-fecha>
    Última actualización: {documento.lastUpdated}
  </p>

  <!-- aria-live: el refresco desde el API reemplaza las secciones después del
       load; sin esto el cambio es mudo para un lector de pantalla. -->
  <div data-legal-secciones aria-live="polite">
    {
      documento.sections.map((seccion) => (
        <section class="documento__seccion">
          <h2 class="documento__seccion-titulo">{seccion.title}</h2>
          <p class="documento__seccion-cuerpo">{seccion.body}</p>
        </section>
      ))
    }
  </div>

  <a class="documento__volver" href="/">Volver al inicio</a>
</article>

<script>
  // Trae el documento vigente del API público y reemplaza el horneado SOLO si es
  // más nuevo.
  //
  // Falla en silencio a propósito: si el API no responde, la página ya está
  // completa con el texto del build. Un documento legal en blanco sería peor que
  // uno con unos días de atraso.
  interface SeccionRemota {
    title: string;
    body: string;
  }

  interface DocumentoRemoto {
    version: string;
    last_updated: string;
    sections: SeccionRemota[];
  }

  // Cuánto se espera al API antes de quedarse con el texto del build. La página
  // ya es legible sin esto: no vale la pena colgar la pestaña de un usuario con
  // mala red esperando un refresco que casi siempre no cambia nada.
  const TIMEOUT_MS = 5000;

  // `timeZone: 'UTC'` porque `last_updated` es un instante ISO: sin fijarla, un
  // documento publicado a medianoche UTC se muestra un día antes en Costa Rica
  // (UTC-6) y la fecha no coincide con la que ve el panel.
  const FORMATO_FECHA = new Intl.DateTimeFormat('es-CR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

  /**
   * ¿La versión remota es posterior a la horneada? Conviven dos formatos: el
   * viejo `YYYY-MM-DD` y el nuevo `YYYY-MM-DD.N`, que numera varias
   * publicaciones del mismo día. Compararlas como texto ordenaría mal en cuanto
   * el contador pase de 9 ('2026-08-04.10' < '2026-08-04.9'), así que la fecha
   * se compara como texto (ISO ya ordena) y el sufijo como número.
   *
   * Una versión ilegible cuenta como no-más-nueva: se queda el texto del build.
   */
  function esMasNueva(remota: string, horneada: string): boolean {
    const [fechaRemota, nRemota] = partirVersion(remota);
    const [fechaHorneada, nHorneada] = partirVersion(horneada);
    if (fechaRemota !== fechaHorneada) return fechaRemota > fechaHorneada;
    return nRemota > nHorneada;
  }

  function partirVersion(version: string): [string, number] {
    const [fecha = '', sufijo] = version.trim().split('.');
    const numero = Number.parseInt(sufijo ?? '', 10);
    return [fecha, Number.isNaN(numero) ? 0 : numero];
  }

  function esDocumento(valor: unknown): valor is DocumentoRemoto {
    const candidato = valor as Partial<DocumentoRemoto> | null;
    return (
      typeof candidato?.version === 'string' &&
      Array.isArray(candidato.sections) &&
      candidato.sections.every(
        (seccion) => typeof seccion?.title === 'string' && typeof seccion?.body === 'string',
      )
    );
  }

  // Astro scopea los estilos del componente con un atributo `data-astro-cid-*`
  // que solo existe en el marcado del build. Los nodos que se crean acá tienen
  // que heredarlo o el documento refrescado sale sin ningún estilo.
  function atributoDeScope(contenedor: HTMLElement): string | undefined {
    return contenedor.getAttributeNames().find((nombre) => nombre.startsWith('data-astro-cid-'));
  }

  function pintar(contenedor: HTMLElement, secciones: SeccionRemota[]): void {
    const scope = atributoDeScope(contenedor);
    const crear = <K extends keyof HTMLElementTagNameMap>(
      etiqueta: K,
      clase: string,
    ): HTMLElementTagNameMap[K] => {
      const nodo = document.createElement(etiqueta);
      nodo.className = clase;
      if (scope) nodo.setAttribute(scope, '');
      return nodo;
    };

    // textContent en cada nodo (nunca innerHTML): el cuerpo es texto plano que
    // viene del panel y no debe interpretarse como marcado.
    contenedor.replaceChildren(
      ...secciones.map((seccion) => {
        const bloque = crear('section', 'documento__seccion');

        const titulo = crear('h2', 'documento__seccion-titulo');
        titulo.textContent = seccion.title;

        const cuerpo = crear('p', 'documento__seccion-cuerpo');
        cuerpo.textContent = seccion.body;

        bloque.append(titulo, cuerpo);
        return bloque;
      }),
    );
  }

  async function refrescar(articulo: HTMLElement): Promise<void> {
    const endpoint = articulo.dataset.legalEndpoint;
    const versionHorneada = articulo.dataset.legalVersion ?? '';
    if (!endpoint) return;

    const respuesta = await fetch(endpoint, { signal: AbortSignal.timeout(TIMEOUT_MS) });
    if (!respuesta.ok) return;

    const cuerpo: unknown = await respuesta.json();
    const remoto = (cuerpo as { data?: unknown } | null)?.data;
    if (!esDocumento(remoto)) return;
    if (remoto.version === versionHorneada || remoto.sections.length === 0) return;
    if (!esMasNueva(remoto.version, versionHorneada)) return;

    const contenedor = articulo.querySelector<HTMLElement>('[data-legal-secciones]');
    if (contenedor) pintar(contenedor, remoto.sections);

    const fecha = articulo.querySelector<HTMLElement>('[data-legal-fecha]');
    const publicado = new Date(remoto.last_updated);
    if (fecha && !Number.isNaN(publicado.getTime())) {
      fecha.textContent = `Última actualización: ${FORMATO_FECHA.format(publicado)}`;
    }
  }

  for (const articulo of document.querySelectorAll<HTMLElement>('[data-legal]')) {
    void refrescar(articulo).catch(() => {
      /* sin red o API caída: se queda el texto del build */
    });
  }
</script>

<style>
  /* 36rem ≈ 72 caracteres. A 44rem la medida llegaba a 88ch y en un documento
     largo se pierde el renglón al volver. */
  .documento {
    width: min(100%, 36rem);
    margin: 0 auto;
    padding-bottom: var(--ritmo-seccion);
  }

  .documento__titulo {
    color: var(--teal);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: lowercase;
    text-wrap: balance;
  }

  .documento__fecha {
    margin-top: var(--e-3);
    color: var(--tinta-suave);
    font-size: 0.8125rem;
  }

  .documento__seccion {
    margin-top: var(--e-6);
  }

  /* 20 px contra 16 de cuerpo: ratio 1.25. A 17 px el peso 700 hacía todo el
     trabajo y los títulos de sección apenas se despegaban del texto. */
  .documento__seccion-titulo {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* pre-line: los saltos de línea que el admin escribe en el panel son parte
     del texto legal (listas, incisos) y tienen que verse acá igual. */
  .documento__seccion-cuerpo {
    margin-top: var(--e-2);
    color: var(--tinta-suave);
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
    white-space: pre-line;
  }

  .documento__volver {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-top: var(--e-7);
    color: var(--teal-texto);
    font-size: 0.9375rem;
    font-weight: 700;
    text-underline-offset: 4px;
  }
</style>
