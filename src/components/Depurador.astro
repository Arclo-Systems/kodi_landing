---
/**
 * Recuadro de diagnóstico del scroll, solo con `?depurar=1` en la URL.
 *
 * Existe porque hay saltos que solo pasan en un teléfono de verdad: la barra
 * del navegador se anima al aparecer y desaparecer, y la inercia táctil no es
 * la del scroll sintético. Desde un Chromium de escritorio no se reproducen,
 * así que el dato tiene que salir del aparato donde se ven.
 *
 * Retiene el peor salto de cada cosa en vez de solo mostrar el valor vivo:
 * cuando se siente el tirón ya pasó, y no da tiempo de leer nada.
 */
---

<div id="depurador" hidden aria-hidden="true">
  <button type="button" id="depurador-reiniciar">reiniciar</button>
  <pre id="depurador-texto"></pre>
</div>

<style>
  #depurador {
    position: fixed;
    top: env(safe-area-inset-top, 0px);
    left: 0;
    z-index: 9999;
    background: #000000e6;
    color: #7cff9b;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11px;
    line-height: 1.45;
    padding: 8px 10px;
    border-bottom-right-radius: 10px;
    max-width: 100%;
    pointer-events: none;
  }
  #depurador pre {
    margin: 0;
    white-space: pre;
  }
  #depurador-reiniciar {
    pointer-events: auto;
    position: absolute;
    top: 6px;
    right: 8px;
    background: #7cff9b;
    color: #000;
    border: 0;
    border-radius: 5px;
    font: inherit;
    font-size: 10px;
    padding: 2px 6px;
  }
</style>

<script>
  if (location.search.includes('depurar')) {
    const caja = document.getElementById('depurador') as HTMLElement | null;
    const texto = document.getElementById('depurador-texto');
    const reiniciar = document.getElementById('depurador-reiniciar');
    if (caja && texto && reiniciar) {
      caja.hidden = false;

      interface Pico {
        valor: number;
        contexto: string;
      }
      const picos = new Map<string, Pico>();
      const anotar = (clave: string, valor: number, contexto: string) => {
        const previo = picos.get(clave);
        if (!previo || Math.abs(valor) > Math.abs(previo.valor)) {
          picos.set(clave, { valor, contexto });
        }
      };

      const numero = (n: number, ancho = 6) => n.toFixed(0).padStart(ancho);

      // Lo que hay que mirar cuando el celular salta: si se movió la caja
      // pegada, si cambió de tamaño, o si el contenido se corrió adentro.
      const foto = (): Record<string, number> => {
        const caja = (sel: string) => document.querySelector(sel)?.getBoundingClientRect() ?? null;
        const hero = caja('.hero');
        const pegado = caja('.pasos-pegado');
        const pista = caja('.pasos-pista');
        const marco = caja('.marco');
        const barras = [...document.querySelectorAll<HTMLElement>('.barrita__llenado')].reduce(
          (suma, n) => {
            const t = n.style.transform;
            if (!t || t === 'none') return suma + 1;
            const m = /scaleX\(([\d.]+)\)/.exec(t);
            return suma + (m ? parseFloat(m[1]) : 0);
          },
          0,
        );
        return {
          'hero.top': hero ? Math.round(hero.top) : NaN,
          'hero.alto': hero ? Math.round(hero.height) : NaN,
          'pegado.top': pegado ? Math.round(pegado.top) : NaN,
          'pegado.alto': pegado ? Math.round(pegado.height) : NaN,
          'pista.top': pista ? Math.round(pista.top) : NaN,
          'pista.alto': pista ? Math.round(pista.height) : NaN,
          'marco.alto': marco ? Math.round(marco.height) : NaN,
          // El ancho del marco es `--pantalla` ya resuelta: la variable en crudo
          // devuelve el texto `min(202px, calc(...))`, que no se puede medir.
          'marco.ancho': marco ? Math.round(marco.width) : NaN,
          avance: Math.round(barras * 100) / 100,
        };
      };

      let fotoAnterior = foto();
      let culpables: string[] = [];
      let montaje = '  (todavía no se montó)';

      let anteriorY = window.scrollY;
      let anteriorAlto = window.innerHeight;
      let anteriorMarco: number | null = null;
      let anteriorLenis: number | null = null;

      const latido = () => {
        const y = window.scrollY;
        const alto = window.innerHeight;

        // Lenis lleva su propio valor de scroll. Si se desincroniza del nativo
        // durante la animación de la barra, la corrección se ve como un tirón.
        const instancia = (window as unknown as { lenisDepuracion?: { scroll: number } })
          .lenisDepuracion;
        const lenis = instancia ? instancia.scroll : null;

        const marcoNodo = document.querySelector('.marco');
        const marco = marcoNodo ? marcoNodo.getBoundingClientRect().top : null;

        const dy = y - anteriorY;
        const dAlto = alto - anteriorAlto;

        // Un salto es que algo se mueva MÁS de lo que se movió el scroll.
        const ahora = foto();
        const medidoAntes = !Object.values(fotoAnterior).some((n) => Number.isNaN(n));

        // El cuadro en que la isla se monta mueve todo de golpe, pero eso NO es
        // el salto que buscamos: se cuenta aparte para no tapar a los demás.
        if (!medidoAntes && !Object.values(ahora).some((n) => Number.isNaN(n))) {
          montaje = `  t=${Math.round(performance.now())}ms  y=${y}  celular.top=${marco === null ? '?' : Math.round(marco)}`;
        }

        if (marco !== null && anteriorMarco !== null && medidoAntes) {
          const esperado = anteriorMarco - dy;
          const desvio = marco - esperado;
          const previo = picos.get('celular');
          if (!previo || Math.abs(desvio) > Math.abs(previo.valor)) {
            // El salto es de un cuadro: hay que guardar QUÉ cambió en ese
            // mismo paso, porque un cuadro después ya no se distingue.
            culpables = Object.keys(ahora)
              .filter((k) => ahora[k] !== fotoAnterior[k])
              .map((k) => `  ${k.padEnd(12)} ${fotoAnterior[k]} → ${ahora[k]}`);
            if (culpables.length === 0) culpables = ['  (nada del layout cambió)'];
          }
          anotar('celular', desvio, `y=${y} dy=${dy} alto=${alto}`);
        }
        if (lenis !== null) {
          anotar('lenis-vs-nativo', lenis - y, `y=${y} alto=${alto}`);
          if (anteriorLenis !== null) {
            anotar('lenis-salto', lenis - anteriorLenis - dy, `y=${y} dy=${dy}`);
          }
        }
        // El hero se mide igual que el celular: cuánto se movió de más respecto
        // de lo que se movió el scroll. En navegadores dentro de apps las barras
        // de arriba y abajo se encogen distinto y ahí es donde se reporta.
        if (medidoAntes && !Number.isNaN(ahora['hero.top']) && !Number.isNaN(fotoAnterior['hero.top'])) {
          anotar('hero', ahora['hero.top'] - (fotoAnterior['hero.top'] - dy), `y=${y} dy=${dy} alto=${alto}`);
          anotar('hero.alto', ahora['hero.alto'] - fotoAnterior['hero.alto'], `y=${y} alto=${alto}`);
        }
        if (dAlto !== 0) anotar('barra', dAlto, `y=${y}`);
        anotar('scroll-cuadro', dy, `y=${y} alto=${alto}`);

        const filas = [
          `scrollY   ${numero(y)}   dy ${numero(dy, 5)}`,
          `innerH    ${numero(alto)}   d  ${numero(dAlto, 5)}`,
          lenis === null ? 'lenis     (sin instancia)' : `lenis     ${numero(lenis)}   vs nativo ${numero(lenis - y, 5)}`,
          marco === null ? 'celular   (fuera de vista)' : `celular   ${numero(marco)}`,
          '',
          'PEORES SALTOS',
          ...[...picos.entries()].map(
            ([clave, p]) => `${clave.padEnd(16)} ${numero(p.valor, 7)}  ${p.contexto}`,
          ),
          '',
          'MONTAJE DE LA ISLA',
          montaje,
          '',
          'EN EL SALTO DEL CELULAR',
          ...culpables,
        ];
        texto.textContent = filas.join('\n');

        fotoAnterior = ahora;
        anteriorY = y;
        anteriorAlto = alto;
        anteriorMarco = marco;
        anteriorLenis = lenis;
        requestAnimationFrame(latido);
      };

      reiniciar.addEventListener('click', () => {
        picos.clear();
        culpables = [];
      });
      requestAnimationFrame(latido);
    }
  }
</script>
