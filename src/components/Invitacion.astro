---
import Pie from './Pie.astro';
import Tarjeta from './Tarjeta.astro';
import Wordmark from './Wordmark.astro';
import { COPY } from '../data/copy';
import { PITCH, type CopyInvitacion } from '../data/invitacion';
import { TIENDAS, rotuloDeTienda } from '../data/tiendas';

interface Props {
  copy: CopyInvitacion;
}

const { copy } = Astro.props;
---

<div class="pantalla">
  <header class="encabezado entra">
    <a href="/" aria-label="Kodi, ir al inicio">
      <Wordmark class="marca" />
    </a>
  </header>

  <main class="centro">
    <h1 class="titular titular--invitacion entra" style="animation-delay: 60ms">
      {copy.titular}
    </h1>

    <p class="bajada entra" style="animation-delay: 120ms">{copy.bajada}</p>

    <p class="codigo entra" style="animation-delay: 150ms" data-codigo hidden>
      <span class="codigo__rotulo">{copy.codigo.rotulo}</span>
      <strong class="codigo__valor" data-codigo-valor></strong>
      <span class="codigo__nota">{copy.codigo.nota}</span>
    </p>

    <section class="bloque entra" style="animation-delay: 180ms">
      <h2 class="rotulo-seccion">{PITCH.rotulo}</h2>
      <p class="pitch">{COPY.bajada}</p>
      <ul class="puntos">
        {PITCH.puntos.map((punto) => <li>{punto}</li>)}
      </ul>
    </section>

    <div class="fila entra" style="animation-delay: 240ms">
      {
        TIENDAS.map((tienda) => (
          <Tarjeta
            icono={tienda.icono}
            rotulo={rotuloDeTienda(tienda)}
            nombre={tienda.nombre}
            href={tienda.url ?? undefined}
          />
        ))
      }
    </div>

    <a class="volver entra" style="animation-delay: 280ms" href="/">Conocé más de Kodi</a>
  </main>

  <Pie class="entra" />
</div>

<script is:inline>
  // El código viaja en la URL (/u/KODI-XXXXXX, /r/KODI-XXXXXX) y la página es
  // estática: se lee acá para que no se pierda al aterrizar. Sin API, sin red.
  (function () {
    var contenedor = document.querySelector('[data-codigo]');
    if (!contenedor) return;

    var crudo = '';
    try {
      // El split va ANTES del decode: así un %2F no puede inventar segmentos.
      crudo = decodeURIComponent(location.pathname.split('/')[2] || '');
    } catch (error) {
      return; // URL mal codificada: se queda oculto
    }

    // Se valida el formato canónico del código de amigo (`KODI-` + 6 caracteres
    // del alfabeto sin I, L, O, 0 ni 1) en vez de limpiar lo que venga. Si no
    // calza, no se muestra nada: una URL inventada no puede pintar el texto que
    // se le antoje con la tipografía y el dominio de Kodi.
    var codigo = crudo.trim().toUpperCase();
    if (!/^KODI-[A-HJKMNP-Z2-9]{6}$/.test(codigo)) return;

    // textContent, nunca innerHTML.
    contenedor.querySelector('[data-codigo-valor]').textContent = codigo;
    contenedor.hidden = false;
  })();
</script>

<style>
  /* El titular de la home es una interjección corta y puede ser gigante; acá
     son frases y necesitan un techo más bajo para no comerse la pantalla. */
  .titular--invitacion {
    font-size: clamp(2.25rem, 7vw, 4.5rem);
    max-width: 16ch;
  }

  .codigo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: calc(1rem - 1px) calc(1.75rem - 1px);
    border: 2px solid var(--teal);
    border-radius: 0.875rem;
    background: var(--tarjeta);
  }

  /* El atributo `hidden` tiene que ganarle al display de arriba: el bloque
     nace oculto y solo aparece si la URL traía un código. */
  .codigo[hidden] {
    display: none;
  }

  .codigo__rotulo {
    color: var(--tinta-suave);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .codigo__valor {
    color: var(--teal);
    font-size: clamp(1.5rem, 6vw, 2.125rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.1;
    word-break: break-all;
  }

  .codigo__nota {
    color: var(--tinta-suave);
    font-size: 0.8125rem;
  }

  .pitch {
    max-width: 42ch;
    color: var(--tinta-suave);
    font-size: 1rem;
  }

  .puntos {
    width: min(100%, 30rem);
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .puntos li {
    padding: 0.875rem 0;
    color: var(--tinta);
    font-size: 1rem;
  }

  .puntos li + li {
    border-top: 1px solid var(--borde);
  }

  .volver {
    color: var(--teal);
    font-size: 0.9375rem;
    font-weight: 700;
    text-underline-offset: 4px;
  }
</style>
