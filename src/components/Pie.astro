---
import { COPY } from '../data/copy';

interface Props {
  class?: string;
  /** Solo para el retardo de la animación de entrada de cada página. */
  style?: string;
}

const { class: className, style } = Astro.props;
---

<footer class:list={['pie', className]} style={style}>
  <nav class="pie__enlaces" aria-label="Legal">
    <a href="/terminos">Términos de uso</a>
    <a href="/privacidad">Política de privacidad</a>
    <a href="/bases">Bases de premiaciones</a>
  </nav>
  <p class="pie__legal">
    {COPY.pie.copyright} ·{' '}
    <a href={COPY.pie.marcaUrl} target="_blank" rel="noopener noreferrer">
      {COPY.pie.marca}<span class="oculto"> (se abre en una pestaña nueva)</span>
    </a>
  </p>
</footer>

<style>
  /* El pie reclama su propio espacio: antes toda la separación era el sobrante
     de `flex: 1` en el contenido y en una pantalla baja quedaba a 1 px de la
     última tarjeta. Ahora hay margen, regla y padding propios, así que el piso
     no depende del alto del viewport. */
  .pie {
    margin-top: var(--ritmo-seccion);
    padding-block: var(--e-5);
    padding-bottom: max(var(--e-5), env(safe-area-inset-bottom));
    border-top: 1px solid var(--borde);
    color: var(--tinta-suave);
    font-size: 0.875rem;
    text-align: center;
  }

  .pie__enlaces {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--e-1) var(--e-5);
  }

  /* min-height 44 y no 24: los enlaces del pie medían 20 px de alto en la zona
     del pulgar. El aire entre filas lo da el área táctil, no el gap. */
  .pie__enlaces a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding-inline: var(--e-1);
    color: var(--tinta-suave);
    text-decoration-color: var(--borde);
    text-underline-offset: 3px;
    transition: color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .pie__enlaces a:hover {
      color: var(--teal-texto);
      text-decoration-color: currentColor;
    }
  }

  .pie__legal {
    font-size: 0.8125rem;
  }

  /* Mismo trato que los enlaces legales: mismo color, mismo hover, misma área
     táctil. Solo la marca es enlace, no la línea entera. */
  .pie__legal a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding-inline: var(--e-1);
    color: var(--tinta-suave);
    text-decoration-color: var(--borde);
    text-underline-offset: 3px;
    vertical-align: middle;
    transition: color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .pie__legal a:hover {
      color: var(--teal-texto);
      text-decoration-color: currentColor;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pie__enlaces a,
    .pie__legal a {
      transition: none;
    }
  }
</style>
