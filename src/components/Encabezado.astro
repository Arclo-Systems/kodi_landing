---
import { COPY, URL_PLAY } from '../data/copy';
---

{/* Cabecera calcada de la referencia: flota sobre el contenido, sin fondo
    propio, con tres islas en píldora.
    Fuera queda su bloque de "Login / Sign up": Kodi no tiene sesión en la web,
    y ese hueco lo ocupa el único botón que importa, el de descargar. */}
<header class="cabecera" id="cabecera">
  {/* El isotipo cuadrado y no el wordmark: el logotipo es ancho y dentro de un
      círculo de 52 px se recorta. Es el mismo archivo que usa la pestaña. */}
  <a class="cabecera__marca" href="#inicio" aria-label="Kodi, ir al inicio">
    <img src="/favicon.svg" alt="" width="52" height="52" />
  </a>

  <nav class="cabecera__pildora" aria-label="Secciones">
    <a href="#examenes">{COPY.nav.examenes}</a>
    <a href="#como">{COPY.nav.como}</a>
  </nav>

  {/* La píldora del centro: en la referencia lleva el menú y el porcentaje de
      avance del scroll. Acá el porcentaje se queda —dice cuánta página falta,
      que en una landing larga es información real— y el menú se va, porque las
      secciones ya están en la píldora de la izquierda. */}
  <div class="cabecera__avance">
    <span class="cabecera__avance-numero" id="avance">0%</span>
  </div>

  <a class="cabecera__cta" href={URL_PLAY}>{COPY.nav.descargar}</a>
</header>

<script>
  // Porcentaje de avance del scroll. En un `requestAnimationFrame` y no en el
  // evento directo: el listener de scroll se dispara decenas de veces por
  // segundo y escribir en el DOM en cada uno provoca recálculos de layout.
  const salida = document.getElementById('avance');

  if (salida) {
    let pendiente = false;

    const pintar = () => {
      pendiente = false;
      const recorrido = document.documentElement.scrollHeight - window.innerHeight;
      const avance = recorrido > 0 ? Math.round((window.scrollY / recorrido) * 100) : 0;
      salida.textContent = `${Math.min(100, Math.max(0, avance))}%`;
    };

    const agendar = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(pintar);
    };

    window.addEventListener('scroll', agendar, { passive: true });
    window.addEventListener('resize', agendar);
    pintar();
  }
</script>

<style>
  .cabecera {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: var(--e-4);
    height: 80px;
    padding-inline: clamp(var(--e-4), 3vw, var(--e-7));
  }

  .cabecera__marca {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 999px;
    background: var(--tarjeta);
    overflow: hidden;
  }

  .cabecera__marca img {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Píldora de secciones: blanca, borde de un píxel, radio completo. */
  .cabecera__pildora {
    display: flex;
    align-items: center;
    gap: var(--e-1);
    height: 52px;
    padding: 6px;
    border-radius: 999px;
    border: 1px solid var(--borde);
    background: var(--tarjeta);
  }

  .cabecera__pildora a {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding-inline: var(--e-4);
    border-radius: 999px;
    color: var(--tinta);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .cabecera__pildora a:hover {
      background: var(--superficie);
    }
  }

  /* La píldora oscura del centro. `margin-inline: auto` la empuja al medio sin
     sacarla del flujo, así en pantallas angostas se acomoda sola. */
  .cabecera__avance {
    display: inline-flex;
    align-items: center;
    gap: var(--e-3);
    height: 52px;
    margin-inline: auto;
    padding: 8px;
    border-radius: 999px;
    background: var(--tinta);
    color: var(--superficie);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .cabecera__avance-numero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 52px;
    height: 36px;
    padding-inline: var(--e-2);
    border-radius: 999px;
    background: color-mix(in srgb, var(--superficie) 18%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .cabecera__cta {
    display: inline-flex;
    align-items: center;
    height: 52px;
    flex: none;
    padding-inline: var(--e-6);
    border-radius: 999px;
    background: var(--tinta);
    color: var(--superficie);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 300ms var(--salida);
  }

  @media (hover: hover) and (pointer: fine) {
    .cabecera__cta:hover {
      transform: translateY(-2px);
    }
  }

  /* En móvil solo quedan la marca y el botón: tres píldoras en 390 px dejan al
     botón sin lugar, y el camino a la descarga ahí es la barra de abajo. */
  @media (max-width: 860px) {
    .cabecera__pildora,
    .cabecera__avance {
      display: none;
    }

    .cabecera__cta {
      margin-inline-start: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cabecera__cta,
    .cabecera__pildora a {
      transition: none;
    }
  }
</style>
