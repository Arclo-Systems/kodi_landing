---
import MarcaKodi from './iconos/MarcaKodi.astro';
import MenuPildora from './islas/MenuPildora';
import { COPY } from '../data/copy';
import { SOCIAL } from '../data/social';

// La cabecera de la referencia, replicada: a la izquierda la marca en un
// círculo y una píldora con dos secciones; al centro la píldora del menú, que
// se ensancha, muestra el avance de la página y despliega el resto; a la
// derecha el único destacado.
//
// El menú del centro es una isla (Motion anima ancho, alto y los enlaces uno
// detrás de otro); lo demás es Astro, porque son enlaces y un hover.
const MENU = [
  {
    titulo: 'Menú',
    grande: true,
    enlaces: [
      { texto: COPY.nav.examenes, href: '#examenes' },
      { texto: COPY.nav.como, href: '#como' },
      { texto: 'Precios', href: '#precios' },
      { texto: 'Preguntas', href: '#faq' },
    ],
  },
  {
    titulo: 'Otros',
    enlaces: [
      { texto: 'Empresas', href: '/empresas' },
      { texto: 'Términos de uso', href: '/terminos' },
      { texto: 'Política de privacidad', href: '/privacidad' },
      { texto: 'Soporte', href: 'mailto:soporte@holakodi.com' },
    ],
  },
  {
    titulo: COPY.redes,
    enFila: true,
    enlaces: [
      { texto: 'Instagram', href: SOCIAL.instagram.href, externo: true },
      { texto: 'TikTok', href: SOCIAL.tiktok.href, externo: true },
      { texto: 'Facebook', href: SOCIAL.facebook.href, externo: true },
    ],
  },
];
---

<header class="cabecera">
  <div class="cabecera__fila">
    <div class="cabecera__izquierda">
      {/* La marca en un círculo con borde, como la referencia: la silueta del
          ícono de la app sobre la superficie. Quieta, sin giro. */}
      <a class="sello" href="#inicio" aria-label="Kodi, ir al inicio">
        <span class="sello__circulo">
          <MarcaKodi tamano={32} class="sello__dibujo" />
        </span>
      </a>

      <nav class="pastilla" aria-label="Secciones">
        <a href="#examenes">{COPY.nav.examenes}</a>
        <a href="#como">{COPY.nav.como}</a>
      </nav>
    </div>

    <div class="cabecera__centro">
      <MenuPildora client:idle abrir="Menú" cerrar="Cerrar" grupos={MENU} />
    </div>

    {/* Empresas ocupa el lugar del "Sign up" de la referencia (el "Login" no
        va). Estuvo apagado hasta que la página existió. */}
    <div class="cabecera__derecha">
      <a class="cabecera__destacado" href="/empresas">Empresas</a>
    </div>
  </div>
</header>

<style>
  .cabecera {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
  }

  /* El alto sale del token: es el mismo número con el que las secciones
     calculan dónde tiene que frenar un ancla. */
  .cabecera__fila {
    position: relative;
    display: flex;
    height: var(--alto-cabecera);
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--pad-seccion);
  }

  .cabecera__izquierda {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* El menú va pegado al borde derecho en móvil y centrado en la ventana desde
     768, igual que la referencia. */
  .cabecera__centro {
    position: absolute;
    top: 6px;
    right: 20px;
    z-index: 50;
  }

  @media (min-width: 768px) {
    .cabecera__centro {
      right: auto;
      left: 50%;
      translate: -50%;
    }
  }

  .sello {
    display: inline-flex;
    border-radius: 9999px;
  }

  .sello__circulo {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    border: 1px solid var(--borde);
    border-radius: 50%;
    background: var(--superficie);
    /* La silueta hereda este color: el teal de marca en claro, blanco en
       oscuro. El bloque se llama `sello` y no `marca` porque esa clase ya
       existe en el CSS viejo (`global.css`) y le pisaba el color. */
    color: var(--teal);
  }

  :root[data-tema='oscuro'] .sello__circulo {
    color: #fff;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-tema='claro']) .sello__circulo {
      color: #fff;
    }
  }

  .sello__dibujo {
    display: block;
  }

  /* Las secciones viven dentro de una píldora con borde; desde 768 para
     arriba, porque en móvil ya están en el menú. */
  .pastilla {
    display: none;
    height: 52px;
    align-items: center;
    gap: 4px;
    padding: 6px;
    border: 1px solid var(--borde);
    border-radius: 9999px;
    background: var(--superficie);
  }

  @media (min-width: 768px) {
    .pastilla {
      display: flex;
    }
  }

  .pastilla a {
    display: flex;
    height: 40px;
    align-items: center;
    padding-inline: 20px;
    border-radius: 9999px;
    color: var(--tinta-suave);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .pastilla a:hover {
      color: var(--tinta);
    }
  }

  .cabecera__derecha {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Tinta plena de fondo, como el "Sign up" de la referencia. Oculto en
     móvil: ahí el ancho lo ocupa la píldora del menú. */
  .cabecera__destacado {
    display: none;
    height: 52px;
    align-items: center;
    padding-inline: 24px;
    border-radius: 9999px;
    background: var(--tinta);
    color: var(--superficie);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition: opacity 160ms ease;
  }

  @media (min-width: 768px) {
    .cabecera__destacado {
      display: inline-flex;
    }
  }

  /* Mientras no tenga página, se dibuja como la píldora de la izquierda —mismo
     borde, mismo fondo, mismo rótulo suave— y no como el botón lleno de la
     referencia: eso promete un destino que todavía no existe. Cuando el sitio
     de empresas exista, se le quita esta clase y vuelve a ser el botón lleno. */
  .cabecera__destacado--apagado {
    border: 1px solid var(--borde);
    background: var(--superficie);
    color: var(--tinta-suave);
    cursor: default;
  }

  @media (hover: hover) and (pointer: fine) {
    .cabecera__destacado:hover {
      opacity: 0.85;
    }

    .cabecera__destacado--apagado:hover {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pastilla a,
    .cabecera__destacado {
      transition: none;
    }
  }
</style>

<style is:global>
  /* Estilos de la isla del menú: el marcado lo pinta React. */
  .pildora {
    position: relative;
    border-radius: 28px;
    padding: 8px;
  }

  .pildora__fondo {
    position: absolute;
    inset: 0;
    border: 1px solid var(--borde);
    border-radius: 28px;
    background: var(--superficie);
    pointer-events: none;
  }

  .pildora__cuerpo {
    position: relative;
  }

  /* La barra invierte los colores de la página: tinta de fondo, superficie de
     letra. Es lo que la separa del resto de la cabecera. */
  .pildora__barra {
    display: flex;
    height: 52px;
    width: 100%;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding-inline: 6px;
    border-radius: 9999px;
    background: var(--tinta);
    color: var(--superficie);
  }

  @media (min-width: 768px) {
    .pildora__barra {
      justify-content: space-between;
      padding-right: 8px;
    }
  }

  .pildora__boton {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;

    border: 0;
    border-radius: 9999px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      opacity 160ms ease,
      transform 140ms var(--salida);
  }

  @media (hover: hover) and (pointer: fine) {
    .pildora__boton:hover {
      opacity: 0.8;
    }
  }

  /* Con el dedo el botón llegaba a 33px de alto. Donde no hay puntero fino,
     el mínimo táctil. */
  @media (pointer: coarse) {
    .pildora__boton {
      min-height: 44px;
    }
  }

  /* Las dos rayas del ícono, apiladas en la misma celda para poder cruzarlas
     en aspa sin mover nada de sitio. */
  .pildora__icono {
    position: relative;
    display: grid;
    width: 16px;
    height: 16px;
    place-items: center;
  }

  .pildora__icono span {
    grid-area: 1 / 1;
    width: 15px;
    height: 1.6px;
    border-radius: 9999px;
    background: currentColor;
  }

  /* El rótulo rota deslizándose; el alto fijo y el recorte son los que impiden
     que se vea la palabra saliente fuera de la píldora. */
  .pildora__rotulo {
    position: relative;
    display: grid;
    align-items: center;
    overflow: hidden;
  }

  .pildora__rotulo > span {
    grid-area: 1 / 1;
    text-align: left;
    white-space: nowrap;
  }

  .pildora__rotulo--seco {
    display: inline-block;
  }

  .pildora__avance {
    min-width: 56px;
    flex: none;
    padding: 6px 12px;
    border-radius: 9999px;
    background: color-mix(in srgb, currentColor 16%, transparent);
    font-size: 0.8125rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .pildora__panel {
    overflow: hidden;
  }

  .pildora__centrado {
    display: flex;
    justify-content: center;
  }

  .pildora__lista {
    width: 280px;
    flex: none;
    padding: 28px 16px 12px;
  }

  .pildora__grupo--separado {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--borde);
  }

  .pildora__titulo {
    display: block;
    margin-bottom: 4px;
    color: var(--tinta-suave);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pildora__columna {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pildora__fila {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .pildora__enlace {
    width: fit-content;
    color: var(--tinta);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .pildora__enlace:hover {
      color: var(--tinta-suave);
    }
  }

  /* El primer grupo es el índice de la página: tipografía de titular. */
  .pildora__grupo--grande .pildora__enlace {
    font-size: 1.625rem;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .pildora__grupo--grande .pildora__columna {
    gap: 8px;
  }

  .pildora__telon {
    position: fixed;
    inset: 0;
    z-index: -10;
    border: 0;
    background: none;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .pildora__enlace,
    .pildora__boton {
      transition: none;
    }
  }
</style>
