---
import nunitoLatin from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import '@fontsource-variable/nunito/wght.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Páginas que se sirven bajo muchas URLs distintas (invitaciones) y no deben indexarse. */
  noindex?: boolean;
  /** Origen al que la página va a pegarle apenas cargue (las legales, al API). */
  preconnect?: string;
}

const { title, description, noindex = false, preconnect } = Astro.props;

// Sin canonical ni og:url cuando la página es noindex: las de invitación se
// sirven bajo /u/* y /r/*, así que su URL real no se puede calcular en el build.
// Declarar la del archivo (/invitacion) haría que las redes compartan un enlace
// sin el código y le diría a Google que indexe lo que acabamos de excluir.
const canonical =
  !noindex && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imagen = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'Kodi',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'iOS, Android',
  description,
  inLanguage: 'es-CR',
  areaServed: 'CR',
};
---

<!doctype html>
<html lang="es-CR">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: sin esto, env(safe-area-inset-*) vale 0 y el pie
         queda debajo de la barra del iPhone con notch. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={nunitoLatin} crossorigin />
    {preconnect && <link rel="preconnect" href={preconnect} crossorigin />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafafa" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kodi" />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagen} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagen} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
  </head>
  <body>
    <a class="salto" href="#contenido">Ir al contenido</a>
    <slot />
  </body>
</html>
