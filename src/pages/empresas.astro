---
import BaseLayout from '../layouts/BaseLayout.astro';
import CambioTema from '../components/CambioTema.astro';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import Pasos from '../components/secciones/Pasos.astro';
import ScrollSuave from '../components/ScrollSuave.astro';
import { EMPRESAS } from '../data/empresas';

const { cierre, formas } = EMPRESAS;
const escribir = `mailto:${cierre.correo}?subject=${encodeURIComponent(cierre.asunto)}`;
---

<BaseLayout
  title="Kodi para empresas"
  description="Tu marca dentro de Kodi: cupones que los estudiantes canjean con lo que ganan practicando, premios de temporada y video patrocinado."
>
  <ScrollSuave />
  <Encabezado />
  <main id="contenido" tabindex="-1">
    <section class="portada">
      <h1>{EMPRESAS.titulo}</h1>
      <p class="bajada">{EMPRESAS.bajada}</p>
      <a class="cta" href={escribir}>{cierre.boton}</a>
    </section>

    <section class="bloque">
      <h2>{EMPRESAS.porQue.titulo}</h2>
      <ul class="lista">
        {
          EMPRESAS.porQue.puntos.map((punto) => (
            <li>
              <h3>{punto.titulo}</h3>
              <p>{punto.texto}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {/* La misma secuencia pegada de la home, con otro contenido. La de cupones
        usa la pantalla de Beneficios, que ya existe; las otras dos son
        provisionales hasta que se armen las suyas. */}
    <Pasos
      id="formas"
      titular={formas.titular}
      bajada={formas.bajada}
      pasos={formas.pasos}
      pantallas={formas.pantallas}
    />

    <section class="cierre">
      <h2>{cierre.titulo}</h2>
      <p>{cierre.texto}</p>
      <a class="cta" href={escribir}>{cierre.boton}</a>
    </section>
  </main>
  <Pie />
  <CambioTema />
</BaseLayout>

<style>
  .portada,
  .bloque,
  .cierre {
    max-width: var(--caja);
    margin-inline: auto;
    padding-inline: var(--pad-seccion);
  }

  .portada {
    /* La cabecera es fija: el contenido arranca debajo de ella. */
    padding-block: calc(var(--alto-cabecera) + var(--aire-seccion)) var(--aire-seccion);
    max-width: 44ch;
    display: grid;
    gap: var(--ritmo-bloque);
  }

  .bloque {
    padding-block-end: var(--aire-seccion);
  }

  h1 {
    font-family: var(--fuente-titular);
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--tinta);
    margin: 0;
    text-wrap: balance;
  }

  .bajada {
    font-size: var(--sub);
    line-height: 1.55;
    color: var(--tinta-suave);
    margin: 0;
  }

  h2 {
    font-family: var(--fuente-titular);
    font-size: clamp(1.375rem, 3vw, 2rem);
    letter-spacing: -0.01em;
    color: var(--tinta);
    margin: 0 0 var(--ritmo-bloque);
  }

  /* Una columna en angosto y tres en ancho: los tres puntos se leen de corrido
     en el teléfono y se comparan de un vistazo en escritorio. */
  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--ritmo-seccion);
  }

  @media (min-width: 768px) {
    .lista {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .lista h3 {
    font-family: var(--fuente-titular);
    font-size: 1.125rem;
    color: var(--tinta);
    margin: 0 0 var(--ritmo-grupo);
  }

  .lista p,
  .cierre p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--tinta-suave);
    margin: 0;
    max-width: 42ch;
  }

  .cierre {
    display: grid;
    gap: var(--ritmo-bloque);
    justify-items: start;
    padding-block: var(--aire-seccion);
  }

  .cta {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    background: var(--pizarra);
    color: var(--sobre-pizarra);
    text-decoration: none;
    font-family: var(--fuente-titular);
    font-size: 1rem;
    padding: var(--e-3) var(--e-6);
    border-radius: 999px;
    transition: transform 160ms var(--salida);
  }

  .cta:active {
    transform: scale(0.97);
  }
</style>
