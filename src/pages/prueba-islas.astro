---
// Andamio: el hero y la cabecera nuevos, para verlos antes de armar la página
// entera. Se borra en la última tarea.
import BaseLayout from '../layouts/BaseLayout.astro';
import Encabezado from '../components/Encabezado.astro';
import Hero from '../components/secciones/Hero.astro';
import Video from '../components/secciones/Video.astro';
import { COPY } from '../data/copy';
---

<BaseLayout title={COPY.titulo} description={COPY.descripcion} noindex>
  <Encabezado />
  <main id="contenido">
    <Hero />
    <Video />
    <section style="min-height: 120vh; padding: 6rem 2rem">
      <p style="color: var(--tinta-suave)">Resto de la página, para probar el porcentaje de avance.</p>
    </section>
  </main>
</BaseLayout>
