---
import BaseLayout from '../layouts/BaseLayout.astro';
import CambioTema from '../components/CambioTema.astro';
import DocumentoLegal from '../components/DocumentoLegal.astro';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import { RAFFLE_RULES_DOC } from '../data/legal';
import { API_BASE_URL } from '../data/api';
---

<BaseLayout
  title="Bases de premiaciones · Kodi"
  description="Cómo funcionan las premiaciones de Kodi: quién puede participar, cómo se gana, los premios y la entrega."
  preconnect={API_BASE_URL}
>
  <div class="pantalla">
    <Encabezado />

    <main id="contenido" tabindex="-1">
      <DocumentoLegal doc="raffle_rules" documento={RAFFLE_RULES_DOC} />
    </main>

    <Pie />
    <CambioTema />
  </div>
</BaseLayout>
