---
import BaseLayout from '../layouts/BaseLayout.astro';
import CambioTema from '../components/CambioTema.astro';
import DocumentoLegal from '../components/DocumentoLegal.astro';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import { PRIVACY_DOC } from '../data/legal';
import { API_BASE_URL } from '../data/api';
---

<BaseLayout
  title="Política de privacidad · Kodi"
  description="Qué datos recopila Kodi, para qué los usa, con quién los comparte y cómo ejercer tus derechos."
  preconnect={API_BASE_URL}
>
  <div class="pantalla">
    <Encabezado />

    <main id="contenido" tabindex="-1">
      <DocumentoLegal doc="privacy" documento={PRIVACY_DOC} />
    </main>

    <Pie />
    <CambioTema />
  </div>
</BaseLayout>
