---
import '@fontsource-variable/nunito/wght.css';
import '@fontsource-variable/geist/wght.css';
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import { COPY } from '../data/copy';

// La tarjeta social. Se captura a mano a 1200x630 y se guarda en `public/og.png`;
// el texto sale del copy, así que hay que recapturarla cuando el titular cambie.
---

<!doctype html>
<!-- El tema va fijo: sin esto la tarjeta salía clara u oscura según lo que
     tuviera la máquina desde la que se captura. -->
<html lang="es-CR" data-tema="claro">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG</title>
    <style is:global>
      body {
        display: flex;
        width: 1200px;
        height: 630px;
        flex-direction: column;
        justify-content: center;
        gap: 1.5rem;
        padding: 5rem;
        background: var(--superficie);
      }

      .og-marca svg {
        display: block;
        width: 8rem;
        height: auto;
        color: var(--teal);
      }

      /* Mismos rasgos que el titular del hero: Geist, peso 500 e interletrado
         cerrado. En Nunito 900 la tarjeta no se parecía a la página. */
      .og-titular {
        color: var(--tinta);
        font-family: var(--fuente-titular);
        font-size: 5.5rem;
        font-weight: 500;
        letter-spacing: -0.028em;
        line-height: 1.02;
      }

      .og-bajada {
        max-width: 44ch;
        color: var(--tinta-suave);
        font-size: 1.75rem;
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <div class="og-marca">
      <Wordmark />
    </div>
    <p class="og-titular">{COPY.titular}</p>
    <p class="og-bajada">{COPY.bajada}</p>
  </body>
</html>
