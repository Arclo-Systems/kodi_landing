---
// La landing. Diez secciones, de arriba abajo: el hero con el campo de
// órbitas, el manifiesto, los cinco exámenes, de dónde sale el material, cómo
// funciona, los países, los planes, las preguntas y el cierre de descarga.
//
// Se construyó aparte, en una página de andamio, y ocupó este lugar cuando
// estuvo entera. La versión anterior era una sola pantalla con la lista de
// módulos y la lista de espera.
import BaseLayout from '../layouts/BaseLayout.astro';
import CambioTema from '../components/CambioTema.astro';
import Encabezado from '../components/Encabezado.astro';
import ScrollSuave from '../components/ScrollSuave.astro';
import Examenes from '../components/secciones/Examenes.astro';
import Fuentes from '../components/secciones/Fuentes.astro';
import Hero from '../components/secciones/Hero.astro';
import Manifiesto from '../components/secciones/Manifiesto.astro';
import Pie from '../components/Pie.astro';
import Pasos from '../components/secciones/Pasos.astro';
import Planes from '../components/secciones/Planes.astro';
import Preguntas from '../components/secciones/Preguntas.astro';
import Descarga from '../components/secciones/Descarga.astro';
import Paises from '../components/secciones/Paises.astro';
import Video from '../components/secciones/Video.astro';
import { COPY } from '../data/copy';
---

<BaseLayout title={COPY.titulo} description={COPY.descripcion}>
  <ScrollSuave />
  <Encabezado />
  <main id="contenido" tabindex="-1">
    <Hero />
    <Video />
    <Manifiesto />
    <Examenes />
    <Fuentes />
    <Pasos />
    <Paises />
    <Planes />
    <Preguntas />
    <Descarga />
  </main>
  <Pie />
  <CambioTema />
</BaseLayout>
