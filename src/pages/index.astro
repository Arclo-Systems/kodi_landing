---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tarjeta from '../components/Tarjeta.astro';
import Wordmark from '../components/Wordmark.astro';
import { COPY } from '../data/copy';
import { SOCIAL } from '../data/social';
---

<BaseLayout title={COPY.titulo} description={COPY.bajada}>
  <div class="pantalla">
    <header class="encabezado entra">
      <Wordmark class="marca" />
    </header>

    <main class="centro">
      <h1 class="titular entra" style="animation-delay: 60ms">{COPY.titular}</h1>

      <p class="bajada entra" style="animation-delay: 120ms">{COPY.bajada}</p>

      <div class="fila entra" style="animation-delay: 180ms">
        <Tarjeta icono="appstore" rotulo="Pronto en" nombre="App Store" />
        <Tarjeta icono="googleplay" rotulo="Pronto en" nombre="Google Play" />
      </div>

      <section class="bloque entra" style="animation-delay: 240ms">
        <h2 class="rotulo-seccion">{COPY.redes}</h2>
        <div class="fila">
          <Tarjeta
            icono="tiktok"
            rotulo="Seguinos en"
            nombre="TikTok"
            href={SOCIAL.tiktok.href}
            acento="tiktok"
          />
          <Tarjeta
            icono="instagram"
            rotulo="Seguinos en"
            nombre="Instagram"
            href={SOCIAL.instagram.href}
            acento="instagram"
          />
          <Tarjeta
            icono="facebook"
            rotulo="Seguinos en"
            nombre="Facebook"
            href={SOCIAL.facebook.href}
            acento="facebook"
          />
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
