---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pie from '../components/Pie.astro';
import Tarjeta from '../components/Tarjeta.astro';
import Wordmark from '../components/Wordmark.astro';
import { COPY } from '../data/copy';
import { SOCIAL } from '../data/social';
import { TIENDAS, rotuloDeTienda } from '../data/tiendas';
---

<BaseLayout title={COPY.titulo} description={COPY.bajada}>
  <div class="pantalla">
    <header class="encabezado entra">
      <Wordmark class="marca" />
    </header>

    <main id="contenido" class="centro">
      <div class="intro entra" style="animation-delay: 60ms">
        <h1 class="titular">{COPY.titular}</h1>
        <p class="bajada">{COPY.bajada}</p>
      </div>

      <div class="fila entra" style="animation-delay: 180ms">
        {
          TIENDAS.map((tienda) => (
            <Tarjeta
              icono={tienda.icono}
              rotulo={rotuloDeTienda(tienda, 'Pronto en')}
              nombre={tienda.nombre}
              href={tienda.url ?? undefined}
            />
          ))
        }
      </div>

      <section class="bloque entra" style="animation-delay: 240ms">
        <h2 class="rotulo-seccion">{COPY.redes}</h2>
        <div class="fila">
          <Tarjeta
            icono="tiktok"
            rotulo="Seguinos en"
            nombre="TikTok"
            href={SOCIAL.tiktok.href}
            acento="tiktok"
          />
          <Tarjeta
            icono="instagram"
            rotulo="Seguinos en"
            nombre="Instagram"
            href={SOCIAL.instagram.href}
            acento="instagram"
          />
          <Tarjeta
            icono="facebook"
            rotulo="Seguinos en"
            nombre="Facebook"
            href={SOCIAL.facebook.href}
            acento="facebook"
          />
        </div>
      </section>
    </main>

    <Pie class="entra" style="animation-delay: 300ms" />
  </div>
</BaseLayout>
