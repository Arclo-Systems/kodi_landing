---
import BaseLayout from '../layouts/BaseLayout.astro';
import CambioTema from '../components/CambioTema.astro';
import DocumentoLegal from '../components/DocumentoLegal.astro';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import { TERMS_DOC } from '../data/legal';
import { API_BASE_URL } from '../data/api';
---

<BaseLayout
  title="Términos de uso · Kodi"
  description="Las condiciones bajo las que podés usar Kodi: cuenta, conducta, suscripciones, propiedad intelectual y ley aplicable."
  preconnect={API_BASE_URL}
>
  <div class="pantalla">
    <Encabezado />

    <main id="contenido" tabindex="-1">
      <DocumentoLegal doc="terms" documento={TERMS_DOC} />
    </main>

    <Pie />
    <CambioTema />
  </div>
</BaseLayout>
