{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.holakodi.com" }],
      "destination": "https://holakodi.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.holakodi.com" }],
      "destination": "https://holakodi.com/:path*",
      "permanent": true
    },
    {
      "source": "/android",
      "destination": "https://play.google.com/store/apps/details?id=com.holakodi.app",
      "permanent": false
    },
    {
      "source": "/ios",
      "destination": "https://apps.apple.com/cr/app/kodi-estudi%C3%A1-y-aprob%C3%A1/id6812542626",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(iPhone|iPad|iPod).*" }],
      "destination": "https://apps.apple.com/cr/app/kodi-estudi%C3%A1-y-aprob%C3%A1/id6812542626",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*Android.*" }],
      "destination": "https://play.google.com/store/apps/details?id=com.holakodi.app",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/u/:path*",
      "destination": "/invitacion-perfil/index.html"
    },
    {
      "source": "/r/:path*",
      "destination": "/invitacion/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "trailingSlash": false
}
